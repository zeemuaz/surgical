# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the deployed application (used for sitemap & canonical URLs).
APP_URL="MY_APP_URL"

# Optional server-side email delivery for RFQ and Contact inquiries.
# When unset, submissions are validated and logged in development preview mode
# rather than claiming email delivery.
RESEND_API_KEY=""
INQUIRY_RECIPIENT_EMAIL=""
INQUIRY_FROM_EMAIL=""
